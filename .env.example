# Local development only. Replace the placeholder in BOTH values below.
# Use a URL-safe password (or percent-encode it in DATABASE_URL).
POSTGRES_USER=postgres
POSTGRES_DB=tasks
POSTGRES_PASSWORD=replace_with_local_password
DATABASE_URL=postgres://postgres:replace_with_local_password@db:5432/tasks

# Supabase Dashboard > Project Settings > API. Never use a service_role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_anon_or_publishable_key
PORT=3000
